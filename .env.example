# Neon pooled connection string; server-side only.
DATABASE_URL=
WILDONES_SITE_URL=https://enterwildones.com
WILDONES_HELP_EMAIL=help@enterwildones.com
WILDONES_APPLICATION_NOTIFY_TO=invites@enterwildones.com
WILDONES_EMAIL_FROM=
