RESEND_API_KEY=
# Resend signing secret is created when the production webhook is registered.
WILDONES_RESEND_WEBHOOK_SECRET=
# Owner-controlled alert mailbox. Do not use a guest mailing list.
WILDONES_EMAIL_ALERT_TO=
# Keep disabled until domain, webhook, email delivery, and scheduled jobs are certified.
WILDONES_EMAIL_AUTOMATION_ENABLED=false

# Fallback single-price admission values. Tiered events use the PHASE variables below.
# AUREVA is tiered: do NOT set legacy WILDONES_AUREVA_2026_TICKET_PRICE_CENTS.
WILDONES_HALORA_2027_TICKET_PRICE_CENTS=
WILDONES_SUNVEIL_2027_TICKET_PRICE_CENTS=
WILDONES_NOCTURNE_2027_TICKET_PRICE_CENTS=

# Owner-approved AUREVA hard limit: exactly 200 paid and complimentary admission tickets.
# Includes paid + comp seats; does not count staff and entertainers.
# Apply Neon migration 003 and reconcile historical tickets before opening sales.
WILDONES_AUREVA_2026_TICKET_CAPACITY=200

# AUREVA phased admission schedule. Times must include an explicit UTC offset.
# FIRST LIGHT ends January 9, 2027 at 11:59:59 PM HST; FULL RADIANCE begins January 10 at midnight.
WILDONES_AUREVA_2026_TICKET_PHASE1_NAME=FIRST LIGHT RELEASE
WILDONES_AUREVA_2026_TICKET_PHASE1_PRICE_CENTS=5500
WILDONES_AUREVA_2026_TICKET_PHASE1_ENDS_AT=2027-01-10T00:00:00-10:00
WILDONES_AUREVA_2026_TICKET_PHASE2_NAME=FULL RADIANCE
WILDONES_AUREVA_2026_TICKET_PHASE2_PRICE_CENTS=7000
WILDONES_AUREVA_2026_TICKET_PHASE2_ENDS_AT=
# ZENITH remains intentionally unpriced until explicitly approved.
WILDONES_AUREVA_2026_TICKET_PHASE3_NAME=
WILDONES_AUREVA_2026_TICKET_PHASE3_PRICE_CENTS=

